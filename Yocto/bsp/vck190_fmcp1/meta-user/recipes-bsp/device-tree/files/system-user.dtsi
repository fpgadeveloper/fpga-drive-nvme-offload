/*
 * SoC-side / PL device-tree fixups for VCK190, layered on top of the
 * gen-machineconf / lopper-generated <...>-linux.dts (which already carries
 * the PS config and the PL xilinx_qdma PCIe Root Ports from the XSA via
 * pl.dtsi). Scoped to the Linux domain by device-tree.bbappend.
 *
 * PCIe outbound-window fix (qdma_0 / qdma_1 `ranges`):
 *   The SDT/lopper-generated `ranges` set the PCI base address to 0x0 (i.e.
 *   PCI 0x0 -> CPU 0xa8000000), but the Versal QDMA bridge forwards CPU
 *   addresses 1:1 to the PCIe bus. With the mismatched ranges the kernel
 *   assigns endpoint BARs near PCI 0x0 while CPU accesses through the window
 *   land at PCI 0xa8000000 -> nothing responds -> AXI decode error surfaces
 *   as an Asynchronous SError and the kernel panics in nvme_pci_enable.
 *   PetaLinux's HSI-generated DT uses 1:1 ranges (PCI addr == CPU addr); we
 *   override to match. (Confirmed on hardware: with this fix both QDMA Root
 *   Ports enumerate and both NVMe SSDs probe cleanly.)
 *
 *   Format: <pci_addr(3 cells) cpu_addr(2 cells) size(2 cells)>; first entry
 *   is the 32-bit MEM window, second is the 64-bit (prefetchable) window.
 *
 * Register order fix (qdma_0 / qdma_1 `reg`):
 *   pcie-xilinx-dma-pl maps reg[0] = "cfg" (ECAM, S_AXI_LITE) and reg[1] =
 *   "breg" (bridge registers, S_AXI_LITE_CSR). sdtgen orders the reg entries
 *   by its own segment walk; in this design (the doorbell master m_axi_db also
 *   maps BAR0) it emits cfg, BAR0 window, CSR, BAR1 -> the driver programs the
 *   bridge registers through the PCIe BAR window and the kernel panics with an
 *   Asynchronous SError in xilinx_pl_dma_pcie_probe (vck190 bench, 2026-10-17).
 *   Pin the order the recorder's DT has (cfg, breg, BAR0 window, BAR1 window);
 *   addresses = the XSA (CTL0 of S_AXI_LITE / S_AXI_LITE_CSR on M_AXI_LPD).
 */

&qdma_0 {
	reg = <0x0 0x84000000 0x0 0x04000000>, <0x0 0x90000000 0x0 0x08000000>,
	      <0x0 0xa8000000 0x0 0x04000000>, <0x4 0x80000000 0x0 0x40000000>;
	ranges = <0x02000000 0x0 0xa8000000  0x0 0xa8000000  0x0 0x04000000>,
		 <0x43000000 0x4 0x80000000  0x4 0x80000000  0x0 0x40000000>;
};

&qdma_1 {
	reg = <0x0 0x88000000 0x0 0x08000000>, <0x0 0x98000000 0x0 0x08000000>,
	      <0x0 0xac000000 0x0 0x04000000>, <0x4 0xc0000000 0x0 0x40000000>;
	ranges = <0x02000000 0x0 0xac000000  0x0 0xac000000  0x0 0x04000000>,
		 <0x43000000 0x4 0xc0000000  0x4 0xc0000000  0x0 0x40000000>;
};

/* Board RJ45s (GEM0 = u198 PHY, GEM1 = u134 PHY): the SDT flow does not
 * describe the board-level TI DP83867 PHYs, so Linux falls back to the
 * Generic PHY driver and the RGMII clock delays are never programmed -
 * the link negotiates 1G but passes no packets. Both PHYs sit on GEM0's
 * MDIO bus (GEM1 has no MDIO: xlnx,has-mdio=0, matching the board).
 * Values from the official versal-vmk180-revA.dts (which vck190 dts
 * includes); reset-gpios omitted because the SDT device tree does not
 * define the gpio1 label - the PHYs power up out of reset from straps.
 * Fixed MACs (one per board, +1 for GEM1)
 * replace the random ones the SDT flow leaves us with, keeping DHCP
 * leases stable across boots.
 * Ported from the 2x-qsfp28-fmc vck190 Yocto BSP (HW-verified on VCK190).
 */
&gem0 {
	local-mac-address = [00 0a 35 06 21 90];
	phy-handle = <&gem0_phy>;
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		gem0_phy: ethernet-phy@1 {
			compatible = "ethernet-phy-id2000.a231";
			reg = <1>;
			ti,rx-internal-delay = <0xb>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
		};
		gem1_phy: ethernet-phy@2 {
			compatible = "ethernet-phy-id2000.a231";
			reg = <2>;
			ti,rx-internal-delay = <0xb>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
		};
	};
};
&gem1 {
	local-mac-address = [00 0a 35 06 21 91];
	phy-handle = <&gem1_phy>;
};

/*
 * FPGA Drive NVMe-offload recorder: the nvrec kernel driver (Yocto/meta-nvrec,
 * sw/nvrec-driver) drives nvrec_core AND the NVMe Host Accelerator through ONE
 * node, so the addresses of both IPs are listed here (include/nvrec_regs.h,
 * vck190_fmcp1 address map, Vivado/src/bd/bd_versal.tcl):
 *   core     nvrec_core registers                 0x4_2001_0000, 4 KB
 *   ha-lite  nvmeha S_AXI_LITE (via its guard)    0x4_2002_0000, 64 KB
 *   irq core nvrec_core irq   pl_ps_irq6 -> GIC SPI 90
 *   irq ha   ha_interrupt     pl_ps_irq7 -> GIC SPI 91
 * (pl_ps_irq0-5 are the two QDMA root ports' interrupts.)
 * opsero,ssd-ports lists the PL root ports in SSD order: qdma_0 = SSD1 =
 * nvmeha SSD 0, qdma_1 = SSD2 = nvmeha SSD 1. The QDMA bridges translate
 * nothing (ranges above are 1:1), so the BAR address Linux assigns is the
 * address the Host Accelerator's doorbell master uses: ha-bar-offset 0, and the
 * SSD BAR must land in the 32-bit window (0xa8000000 / 0xac000000) -- the
 * doorbell master has 32-bit addresses. Hardware-only Host Accelerator queues
 * (opsero,ha-sw-queues = <0>), queue window 0x9000_0000 (the SSDs' view,
 * through the bridges' M_AXI_BRIDGE) as on Zynq UltraScale+.
 * If the block design changes the address map or the interrupt bits, change
 * this node with it.
 *
 * Split ring (register map 1.3, driver 1.2): nvrec_core's second ring port
 * reaches the on-board LPDDR4 (NoC DDR_CH2, 0x600_0000_0000, 4 GB behind one
 * DDRMC with both x32 channels interleaved; DDR_LOW1 is
 * not possible: the QDMA bridge NMUs also reach the DDR4's DDR_LOW0, and one
 * NMU may not span DDR_LOW regions of two NoC instances), mapped for
 * the ring port and the QDMA bridges only -- the A72s have no route to it and
 * no memory node covers it. memory-region reserves its first 1 GB for ring B
 * (no-map: the kernel never maps or allocates it); ring A stays in the CMA
 * pool (cma=, PS DDR4). opsero,ring-stripe-chunk makes the board's default
 * stripe the whole chunk (driver module parameter stripe_kb and the apps'
 * --stripe override it): measured on this board (2x 980 PRO RAID0, ring reader
 * with skid FIFOs), whole chunks play back 10750 MB/s sustained (40 GiB) at
 * MaxPayload 128 and 256 alike, against 10250 / 10500 with 4 KB stripes;
 * recording is drive-bound (10000 MB/s) with any stripe. With whole chunks each
 * SSD reads and writes one memory only.
 */
/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		nvrec_ring1: nvrec-ring1@60000000000 {
			reg = <0x600 0x00000000 0x0 0x40000000>;
			no-map;
		};
	};
};

&amba_pl {
	nvrec: nvrec@420010000 {
		compatible = "opsero,nvrec";
		reg = <0x4 0x20010000 0x0 0x1000>,
		      <0x4 0x20020000 0x0 0x10000>;
		reg-names = "core", "ha-lite";
		interrupt-parent = <&gic>;
		interrupts = <0 90 4>, <0 91 4>;
		interrupt-names = "core", "ha";
		opsero,ssd-ports = <&qdma_0>, <&qdma_1>;
		opsero,ha-sw-queues = <0>;
		memory-region = <&nvrec_ring1>;
		opsero,ring-stripe-chunk;
	};
};
